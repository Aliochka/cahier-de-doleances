{
	# TCP only: no UDP/443 mapping required for this temporary installation.
	servers {
		protocols h1 h2
	}
}

cahierdedoleances.fr {
	# Short HSTS for a temporary installation; no includeSubDomains/preload.
	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# Backend-only paths are deliberately disjoint from the React Router pages.
	@backend path /api/* /auth /auth/* /bookmarks/* /healthz /robots.txt /sitemap.xml
	handle @backend {
		reverse_proxy app:8000 {
			header_up -Forwarded
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
	# No access log: /auth/verify/* contains bearer tokens.
}

www.cahierdedoleances.fr {
	# Preserve the path and query string; automatic HTTPS also covers www.
	redir https://cahierdedoleances.fr{uri} 308
}

http://127.0.0.1:8080 {
	bind 127.0.0.1
	@health path /healthz
	handle @health {
		reverse_proxy app:8000 {
			header_up Host cahierdedoleances.fr
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		respond 404
	}
}
