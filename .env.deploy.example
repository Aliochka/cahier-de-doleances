# Copy to .env.deploy (ignored by Git); chmod 600 .env.deploy.
# Change this tag for each release; keep the previous image for rollback.
APP_IMAGE_TAG=lan-001
LAN_BIND_IP=192.168.1.56
ENV=prod
BASE_URL=http://192.168.1.56:8000
ALLOWED_HOSTS=192.168.1.56,127.0.0.1,localhost
HEALTHCHECK_HOST=192.168.1.56
ENFORCE_HTTPS=false
COOKIE_SECURE=false
TRUSTED_PROXY_IPS=
LOG_MAGIC_LINKS=false
# Use the EXISTING password; percent-encode special characters in the URL.
# Single quotes protect $ and # from Compose interpolation/comment parsing.
DATABASE_URL='postgresql+psycopg2://cahier:REPLACE_WITH_URL_ENCODED_PASSWORD@cahier-postgres:5432/cahier_doleances'
EXPECTED_DB_HOST=cahier-postgres
EXPECTED_DB_NAME=cahier_doleances
EXPECTED_DB_USER=cahier
EXPECTED_PG_MAJOR=17
EXPECTED_ALEMBIC_REVISION=remove_runtime_caches
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
# Required to actually send login emails; no token is printed in prod logs.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
FROM_EMAIL=noreply@cahierdedoleances.fr
FROM_NAME=Cahier de doléances
