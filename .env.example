# PostgreSQL local (connexion par socket Unix, utilisateur système courant)
DATABASE_URL=postgresql:///cahier_doleances_local
ENV="dev"
BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
ENFORCE_HTTPS=false
# Generate a persistent random key: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
# Development only: log magic links when Mailjet is not configured.
LOG_MAGIC_LINKS=true
