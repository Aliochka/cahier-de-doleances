{
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "FormDetail": {
        "properties": {
          "id": {
            "description": "Identifiant historique BIGINT, chaîne décimale sans perte de précision.",
            "pattern": "^[0-9]+$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "Nom public du formulaire historique.",
            "title": "Name",
            "type": "string"
          },
          "questions": {
            "description": "Toutes les questions, selon COALESCE(position, 999999), puis id.",
            "items": {
              "$ref": "#/components/schemas/FormQuestion"
            },
            "title": "Questions",
            "type": "array"
          },
          "questions_count": {
            "description": "Nombre de questions, avec ou sans réponses.",
            "minimum": 0.0,
            "title": "Questions Count",
            "type": "integer"
          },
          "url": {
            "description": "Chemin relatif de la page HTML historique.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "questions_count",
          "url",
          "questions"
        ],
        "title": "FormDetail",
        "type": "object"
      },
      "FormQuestion": {
        "properties": {
          "form_id": {
            "description": "Identifiant historique BIGINT, chaîne décimale sans perte de précision.",
            "pattern": "^[0-9]+$",
            "title": "Form Id",
            "type": "string"
          },
          "id": {
            "description": "Identifiant historique BIGINT, chaîne décimale sans perte de précision.",
            "pattern": "^[0-9]+$",
            "title": "Id",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ordre déclaré dans le questionnaire ; peut être absent.",
            "title": "Position"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "slug": {
            "description": "Slug construit avec le helper des routes HTML.",
            "title": "Slug",
            "type": "string"
          },
          "type": {
            "description": "Type stocké, notamment text, single_choice ou multi_choice. Aucun recodage.",
            "title": "Type",
            "type": "string"
          },
          "url": {
            "description": "Chemin relatif vers la question historique.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "form_id",
          "prompt",
          "type",
          "position",
          "slug",
          "url"
        ],
        "title": "FormQuestion",
        "type": "object"
      },
      "FormSummary": {
        "properties": {
          "id": {
            "description": "Identifiant historique BIGINT, chaîne décimale sans perte de précision.",
            "pattern": "^[0-9]+$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "description": "Nom public du formulaire historique.",
            "title": "Name",
            "type": "string"
          },
          "questions_count": {
            "description": "Nombre de questions, avec ou sans réponses.",
            "minimum": 0.0,
            "title": "Questions Count",
            "type": "integer"
          },
          "url": {
            "description": "Chemin relatif de la page HTML historique.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "questions_count",
          "url"
        ],
        "title": "FormSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/forms": {
      "get": {
        "description": "Ordre stable par identifiant. Une liste vide reste une réponse 200.",
        "operationId": "list_public_forms",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FormSummary"
                  },
                  "title": "Response List Public Forms",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Délai HTTP dépassé."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Erreur inattendue, sans détails internes."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Base de données indisponible."
          }
        },
        "summary": "Lister les formulaires historiques",
        "tags": [
          "Public forms"
        ]
      }
    },
    "/api/v1/forms/{form_id}": {
      "get": {
        "operationId": "get_public_form",
        "parameters": [
          {
            "description": "Identifiant BIGINT positif du formulaire.",
            "in": "path",
            "name": "form_id",
            "required": true,
            "schema": {
              "description": "Identifiant BIGINT positif du formulaire.",
              "maximum": 9223372036854775807,
              "minimum": 1,
              "title": "Form Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Formulaire introuvable."
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Délai HTTP dépassé."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Erreur inattendue, sans détails internes."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Base de données indisponible."
          }
        },
        "summary": "Consulter un formulaire et toutes ses questions",
        "tags": [
          "Public forms"
        ]
      }
    }
  }
}
