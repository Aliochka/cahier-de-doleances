# Configuration locale : seul le modèle sans secrets est versionné.
.env
.env.*
!.env.example

# Les exclusions globales couvrent déjà .venv/, data/ et les caches Python/uv.
models/
embeddings/
indexes/
artifacts/
.cache/
*.egg-info/

# Les corpus, candidats et annotations réels restent locaux.
*.jsonl
evaluation/local/
# Le jeu de requêtes ne contient aucun texte du corpus.
!evaluation/queries.json
