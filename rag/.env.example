# Exemple uniquement : aucune base ni aucun rôle n'est créé par ce projet.
# Choisir explicitement ce fichier avec check-config --env-file .env.example.
# Remplacer les rôles d'exemple par ceux provisionnés ultérieurement en local.
# Le rôle source devra avoir uniquement les droits de lecture sur le corpus.
RAG_SOURCE_DATABASE_URL=postgresql+psycopg2://rag_source_reader@localhost:5432/cahier_doleances
RAG_DATABASE_URL=postgresql+psycopg2://rag_writer@localhost:5432/cahier_rag

# Les noms de bases sont configurables ; la base locale existante peut notamment
# s'appeler cahier_doleances_local. Aucun mot de passe réel ne doit être commité.

# Les contrôles d’identité nécessitent EXECUTE sur pg_catalog.pg_control_system()
# pour les deux rôles. Sans ce droit, migrations et stockage sont refusés.
# schema-upgrade crée le schéma RAG, jamais la base ni les utilisateurs.
