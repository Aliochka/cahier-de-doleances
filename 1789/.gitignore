# Private logs and test artifacts at any depth.
.local/

# Small production summary and test outcomes; no raw texts or private decisions.
!/docs/production-checks.json

# Aggregate documentary correction outcomes; no source texts or private events.
!/docs/boundary-checks.json

# Scoped documentary decisions: references and short source evidence, no human journal.
!/extraction/documentary-finalization.json

# Frozen random boundary sample: metadata and identifiers only.
!/tools/document-review/campaigns/twelve-boundaries.json

# Aggregate finalization results and sample metadata, without source corpus or journals.
!/docs/finalization-checks.json

# Frozen source-check identifiers only; no private decisions.
!/extraction/article-rule-checks.json
!/docs/article-finalization-checks.json

# Aggregate Unicode whitespace classification counts, no private decisions.
!/docs/whitespace-summary.json

# Aggregate thematic production checks and limited source references.
!/docs/thematic-extraction-checks.json

# Frozen fusion-control plans, annotations and aggregate checks only.
!/extraction/fusion-validation-plan.json
!/extraction/fusion-validation-v2.json
!/extraction/fusion-validation-results.json
!/docs/fusion-corrections-checks.json
